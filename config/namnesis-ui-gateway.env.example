# HTTP listener
LISTEN_ADDR=0.0.0.0:3000

# Stompbox TCP control server
STOMPBOX_HOST=127.0.0.1
STOMPBOX_PORT=24639

# Protocol and safety limits
DUMP_COMMAND=Dump Config
END_MARKER=EndConfig
DIAL_TIMEOUT=1s
READ_TIMEOUT=5s
MAX_BYTES=2000000

# Cache refresh intervals
PROGRAM_POLL_INTERVAL=250ms
CONFIG_REFRESH_INTERVAL=10m
PRESET_REFRESH_INTERVAL=30s
SSE_HEARTBEAT_INTERVAL=15s

# Comma-separated preset directories
STOMPBOX_PRESET_DIRS=/opt/namnesis/Stompbox/build-current/Presets,/opt/namnesis/Stompbox/build/Presets

# Optional LAN allowlist
# ALLOWED_SUBNETS=192.168.1.0/24

# Optional serial OLED bridge
OLED_ENABLED=false
OLED_DEVICE=/dev/ttyNAMNESIS_OLED
OLED_BAUD=115200
OLED_INTERVAL=400ms
